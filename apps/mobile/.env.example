# Local Vite dev server proxy target for Django backend (used when running `npm run dev` on http://localhost:3000)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Production web API base URL:
# - Leave empty or set to "same-origin" when served from Django (/student/) or Nginx proxy
# - Or set to an explicit HTTPS origin (e.g. https://math.example.com)
VITE_API_BASE_URL=same-origin

# Capacitor native app (Android/iOS) API base URL:
# - Android emulator local Django: http://10.0.2.2:8000
# - iOS simulator local Django: http://127.0.0.1:8000
# - Production native app: https://math.example.com
VITE_CAPACITOR_API_BASE_URL=https://math.example.com
